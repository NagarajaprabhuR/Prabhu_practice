pipeline{
    agent any
    stages{
        stage('Built'){
            steps{
                sh """
                    docker rmi ghcr.io/nagarajaprabhur/nginx:latest 2>/dev/null || true
                    docker pull ghcr.io/nagarajaprabhur/nginx:latest 
                """
            }
        }
        stage('deploy'){
            steps{
                sh """
                    docker stop nginx 2>/dev/null || true
                    docker rm nginx 2>/dev/null || true
                    docker run -d -p 80:80 -v /root/nginx/index.html:/usr/share/nginx/html/index.html --name nginx ghcr.io/nagarajaprabhur/nginx:latest
                """
            }
        }
    }
}
