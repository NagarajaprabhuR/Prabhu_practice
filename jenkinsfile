pipeline{
    agent any
    stages{
        stage('Built'){
            steps{
                sh """
                    sudo docker rmi ghcr.io/nagarajaprabhur/nginx:latest 2>/dev/null || true
                    sudo docker pull ghcr.io/nagarajaprabhur/nginx:latest 
                """
            }
        }
        stage('deploy'){
            steps{
                sh """
                    sudo docker stop nginx 2>/dev/null || true
                    sudo docker rm nginx 2>/dev/null || true
                    sudo docker run -d -p 80:80 -v $ (pwd)/index.html:/usr/share/nginx/html/index.html --name nginx ghcr.io/nagarajaprabhur/nginx:latest
                """
            }
        }
    }
}
